{
    "name": "surecart/shippo-integration",
    "description": "SureCart integration with Shippo for shipping rates and label printing",
    "type": "wordpress-plugin",
    "keywords": ["wordpress", "plugin", "surecart", "shippo", "shipping"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "SureCartShippo\\": "includes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 includes/",
        "lint-fix": "phpcbf --standard=PSR12 includes/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
